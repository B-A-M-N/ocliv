# Ocliv runtime data and build artifacts — never commit these.
# Runtime state (SQLite, WAL, leases): identity and authorization records.
ocliv-relay-data/
*.db
*.db-wal
*.db-shm
*.db-journal

# Local credentials, certificates, enrollment material.
/etc/ocliv/
*.pem
*.key
*-ca.crt
ocliv-root.crt

# Built binaries and release artifacts.
/ocliv
/ocliv-*
*.tar.gz
packaging/mcp/dist/

# live/ run artifacts: only README, lab-ca.crt, and ocliv-dist/ are
# tracked. Tokens, bindings, logs, state, and stray binaries stay local.
live/*token*
live/*.resource
live/*.log
live/relay-data/
live/fakehome/
live/fixture
live/ocliv
live/go.mod

# Test and tool scratch.
/tmp/

# Negation: the lab CA public root is intentionally tracked (see
# live/README.md). The private key never leaves the relay laptop.
!live/lab-ca.crt
