# Ocliv runtime data and build artifacts — never commit these.
# Runtime state (SQLite, WAL, leases): identity and authorization records.
ocliv-relay-data/
*.db
*.db-wal
*.db-shm
*.db-journal

# Local credentials, certificates, enrollment material.
/etc/ocliv/
*.pem
*.key
*-ca.crt
ocliv-root.crt

# Built binaries, generated release artifacts, and local scratch state.
/dist/
/.scratch/
/live/
/lab-backup/
/events.jsonl
/guidance.md
/~/
/ocliv
/ocliv-*
*.tar.gz
*.zip
packaging/mcp/dist/

# Test and tool scratch.
/tmp/

# Negation: the public lab CA root fixture is intentionally tracked.
# The private key never leaves the relay host.
!tests/fixtures/certs/lab-ca.crt
