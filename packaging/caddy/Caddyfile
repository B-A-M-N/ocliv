# Caddy edge for ocliv relay (staging template — replace {$OCLIV_DOMAIN} and {$OCLIV_ACME_EMAIL}).
# The relay binds loopback only (127.0.0.1:8080); Caddy terminates public
# TLS and asserts the client identity the relay trusts (see
# docs/OPERATOR.md: the edge must overwrite, never append, forwarding
# headers, and must strip anything the visitor smuggled in).
{
	auto_https disable_redirects
}

# Agent control plane + unlock pages.
relay.{$OCLIV_DOMAIN} {
	tls {$OCLIV_ACME_EMAIL}

	reverse_proxy 127.0.0.1:8080 {
		# Overwrite: the relay treats the rightmost entry as the
		# client IP only from a loopback peer.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		# Strip anything the visitor smuggled in.
		header_up -X-Forwarded-Host
	}
}

# Visitor traffic: <label>.t.<domain>, one label per tunnel.
*.t.{$OCLIV_DOMAIN} {
	# Wildcard issuance REQUIRES DNS-01 (ACME HTTP/TLS-ALPN cannot
	# validate a wildcard). `ocliv relay init --edge wildcard` renders
	# this stanza with your --dns-provider/--dns-env values; a file with
	# no active dns line is incomplete and `relay init --check` rejects
	# it. OPERATOR MUST STILL: build Caddy with the provider plugin
	# (stock Caddy ships none; see docs), export the credential env var
	# at Caddy runtime (never commit it), scope the API credential to
	# the ACME challenge zone only, and pre-provision/verify the
	# wildcard before the first public tunnel.
	tls {
		dns {$OCLIV_DNS_PROVIDER} {env.{$OCLIV_DNS_ENV}}
	}

	reverse_proxy 127.0.0.1:8080 {
		# Overwrite, never append (same trusted-edge contract as above).
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		# Strip anything the visitor smuggled in.
		header_up -X-Forwarded-Host
	}
}
