# Skybridge administration MUST NOT be exposed without real OAuth.
OCLIV_OAUTH_ISSUER=https://YOUR-IDP.example.com
OCLIV_OAUTH_AUDIENCE=https://YOUR-SKYBRIDGE-HOST.example.com/mcp
OCLIV_ADMIN_SUBJECT=YOUR-OAUTH-SUB-CLAIM
OCLIV_BIN=/absolute/path/to/ocliv
# Same HOME used when enrolling the Ocliv publisher, optional.
OCLIV_HOME=/absolute/path/to/ocliv-publisher-home
# HTTPS origin where Ocliv path routes live; do NOT append /mcp.
OCLIV_MCP_ORIGIN=https://pop-os.tail8d285a.ts.net/
# Service URLs must be loopback IP literals with path exactly /mcp.
# Resource file is optional; use it when the upstream server reads canonical OAuth resource binding from a file.
OCLIV_SERVICES_JSON=[{"name":"dev-tools","localUrl":"http://127.0.0.1:8765/mcp","resourceFile":"/absolute/path/to/resource.url"}]
