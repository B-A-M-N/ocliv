# This app is a separate hosted MCP server, not the Ocliv tunnel relay itself.
# All values must be supplied at deployment time, not committed.
SERVER_URL=https://your-hosted-mcp-app.example
OCLIV_OAUTH_ISSUER=https://your-identity-provider.example
OCLIV_OAUTH_AUDIENCE=https://your-hosted-mcp-app.example
OCLIV_ALLOWED_SUBJECTS=identity-provider-user-subject
OCLIV_CONTROL_URL=https://your-ocliv-management-plane.example
OCLIV_CONTROL_TOKEN=replace-in-host-secrets
# Exact API paths from YOUR Ocliv control service; no routes are guessed.
OCLIV_STATUS_PATH=
OCLIV_LIST_PATH=
OCLIV_GET_PATH=
OCLIV_PUBLISH_PATH=
OCLIV_UNPUBLISH_PATH=
# Domain(s) that verification may contact. Exact DNS hostname matches only.
OCLIV_PUBLIC_HOSTS=your-public-mcp-domain.example
# Optional: scoped credential for verifying a published MCP endpoint; never the control token.
OCLIV_PROBE_TOKEN=

# Default read-only; enable only after API contract + staging write qualification.
OCLIV_WRITE_ENABLED=false
