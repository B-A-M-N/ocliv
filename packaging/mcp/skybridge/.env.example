# This app is a separate hosted MCP server, not the Ocliv tunnel relay itself.
# All values must be supplied at deployment time, not committed.
SERVER_URL=https://your-hosted-mcp-app.example
OCLIV_OAUTH_ISSUER=https://your-identity-provider.example
OCLIV_OAUTH_AUDIENCE=https://your-hosted-mcp-app.example
OCLIV_ALLOWED_SUBJECTS=identity-provider-user-subject
# Ocliv relay origin (bare https origin) whose signed management API this
# publisher key is enrolled against. Publisher-side only.
OCLIV_RELAY_URL=https://your-ocliv-relay.example
# Agent private key file written by `ocliv login` (base64 seed, 0600).
# Never copy this key to another host; remote deployments need their own
# enrollment, not this file.
OCLIV_AGENT_KEY_FILE=/var/lib/ocliv-publisher/.config/ocliv/agent.key
# Optional override; defaults to the key-derived ID. Accepts hex with or
# without the key- prefix.
OCLIV_AGENT_KEY_ID=
# Optional server-provisioned OAuth access token for full authenticated
# verification (initialize + tools/list). Never model-supplied. When
# unset, verify reports OAUTH_REQUIRED after discovery checks.
OCLIV_VERIFY_TOKEN=
# Write tools (publish/unpublish) are not exposed by this server build.
# Publishing requires a live local publisher lifecycle, not a management
# call; unpublishing stays disabled until its live approval test passes.
OCLIV_WRITE_ENABLED=false
