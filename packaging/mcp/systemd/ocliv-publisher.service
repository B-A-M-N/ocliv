[Unit]
Description=Ocliv MCP publisher (outbound tunnel + route)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ocliv-publisher
Group=ocliv-publisher
EnvironmentFile=/etc/ocliv/publisher.env
StateDirectory=ocliv-publisher
# Foreground publication follows the shared publisher contract:
# SIGTERM closes the lease, while the publication stays registered
# and offline for stable republish. Permanent removal uses `mcp unpublish`.
ExecStart=/bin/sh -c '\
[ -n "$${OCLIV_LOCAL_URL:-}" ] || { echo "ocliv-publisher: OCLIV_LOCAL_URL is unset" >&2; exit 2; }; \
[ -n "$${OCLIV_AUTH:-}" ] || { echo "ocliv-publisher: OCLIV_AUTH must be set explicitly (upstream-oauth or ocliv-managed)" >&2; exit 2; }; \
[ -n "$${OCLIV_PROFILE:-}" ] && export OCLIV_PROFILE; \
set -- mcp publish --local="$${OCLIV_LOCAL_URL}" --auth="$${OCLIV_AUTH}"; \
[ -n "$${OCLIV_NAME:-}" ] && set -- "$$@" --name="$${OCLIV_NAME}"; \
[ -n "$${OCLIV_TTL:-}" ] && set -- "$$@" --ttl="$${OCLIV_TTL}"; \
[ -n "$${OCLIV_STRICT:-}" ] && set -- "$$@" --strict-discovery; \
[ -n "$${OCLIV_RESOURCE_FILE:-}" ] && set -- "$$@" --resource-file="$${OCLIV_RESOURCE_FILE}"; \
exec $${OCLIV_BIN:-/usr/local/bin/ocliv} "$$@"'
WorkingDirectory=/var/lib/ocliv-publisher
Restart=on-failure
RestartPreventExitStatus=2 4 6 7
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/var/lib/ocliv-publisher /var/lib/ocliv
# Enrollment and lease state are owned by the service user under its home.
ReadWritePaths=/home/ocliv-publisher/.config/ocliv

[Install]
WantedBy=multi-user.target
