# Ocliv publisher environment (owner-only 0600). Never commit a
# populated copy. The enrollment key file is created by `ocliv login`.
# Lab/private-CA edge trust bundle (e.g. Caddy `tls internal` root).
# Unset for public-CA edges. Never disables verification.
OCLIV_CACERT=/path/to/lab-ca.crt
# Where the publisher writes the canonical public route URL for the
# local MCP server to advertise (resource binding handoff).
MCP_BINDING_FILE=/var/lib/ocliv-publisher/resource.url
