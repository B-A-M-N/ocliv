# Ocliv publisher environment (owner-only 0600). Never commit a
# populated copy. The enrollment key file is created by `ocliv login`.
# Lab/private-CA edge trust bundle (e.g. Caddy `tls internal` root).
# Unset for public-CA edges. Never disables verification.
OCLIV_CACERT=/path/to/lab-ca.crt
# Required. Managed OAuth suits a basic local MCP server. Select
# upstream-oauth only when the local server provides its own OAuth.
OCLIV_AUTH=ocliv-managed
# Optional named enrollment profile previously created and enrolled as the
# publisher service user. Empty uses its active/default profile.
OCLIV_PROFILE=
# Required local MCP target, for example http://127.0.0.1:18767/mcp.
OCLIV_LOCAL_URL=
# Optional durable identity label.
OCLIV_NAME=piindasky-lab
# Where the publisher writes the canonical public route URL for the
# local MCP server to advertise (resource binding handoff).
OCLIV_RESOURCE_FILE=/var/lib/ocliv-publisher/resource.url
