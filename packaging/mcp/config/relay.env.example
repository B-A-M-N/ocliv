# Ocliv relay environment (root-owned 0600, /etc/ocliv/relay.env).
# Staging: OCLIV_DOMAIN=ocliv.test. Production: the real public domain.
# Never commit a populated copy of this file.
OCLIV_DOMAIN=ocliv.test
# Single-host MCP ingress is explicit opt-in: the exact public hostname
# serving /r/<route-id>/mcp. Unset disables path-route ingress entirely.
OCLIV_MCP_HOST=relay.ocliv.test
# Public edge port minted into route URLs. Unset (or 443) for a standard
# 443 edge; set for a lab/high-port edge (e.g. 8444). A port with no
# OCLIV_MCP_HOST fails closed at startup.
# OCLIV_MCP_PORT=8444
# Control authority override for public hostnames not named
# relay.<domain> (e.g. temporary *.ts.net Funnel ingress). Unset keeps
# the relay.<domain> default.
# OCLIV_RELAY_HOST=
