[Unit]
Description=Refresh Ocliv dynv6 DNS every 15 minutes
Documentation=file:/usr/share/doc/ocliv/SETUP.md

[Timer]
OnBootSec=2min
# Measured from the last run's completion: a run that overruns its
# slot delays the next one instead of overlapping it. Starting an
# already-running oneshot is a no-op, so executions never pile up.
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
