[Unit]
Description=Ocliv dynamic DNS refresh (dynv6, DNS-only)
Documentation=file:/usr/share/doc/ocliv/SETUP.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ocliv
Group=ocliv
# Explicit opt-in: without this env file the service fails instead of
# guessing. OCLIV_DNS_HOST is the zone the relay serves.
EnvironmentFile=/etc/ocliv/dns-refresh.env
# Credential path points into the relay data directory: 0600, owned by
# ocliv. The token itself is never placed in an environment or argv.
ExecStart=/usr/local/bin/ocliv setup --refresh-dns --hostname=${OCLIV_DNS_HOST} --token-file=${OCLIV_DNS_TOKEN_FILE}
# DNS-only: never touches Caddy or the relay. One attempt per trigger;
# the timer re-triggers on its schedule.
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Additional process isolation (compatible with a oneshot DNS-refresh CLI call).
UMask=0077
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
# Failures surface in the journal; the exit status is the CLI's.
StandardOutput=journal
StandardError=journal
