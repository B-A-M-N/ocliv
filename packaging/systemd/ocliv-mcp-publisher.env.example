# ocliv-mcp-publisher env file (EXAMPLE — copy, fill in, secure).
#
# Install: cp ocliv-mcp-publisher.env.example /etc/ocliv/publisher.env
#   then as root: chown root:root /etc/ocliv/publisher.env
#                  chmod 0600 /etc/ocliv/publisher.env
# The file is root-owned 0600: it selects the published backend and
# identity label, and shares a path with enrollment-adjacent config.
# It holds NO SECRETS — never put keys, tokens, or passwords here.
# Enrollment (key + relay URL from `ocliv login` as user ocliv) stays in
# ~ocliv/.config/ocliv and is NOT configured here.
#
# Syntax is systemd EnvironmentFile (KEY=value, no `export`, no shell
# expansions). Plain assignments also source cleanly in POSIX sh.
#
# GRACEFUL STOP vs PERMANENT UNPUBLISH:
# `systemctl stop` only SIGTERMs the publisher: it deletes the route and
# closes the lease, then exits. A later `start` (or boot, if enabled)
# RE-PUBLISHES. To end a publication permanently, `systemctl disable
# --now ocliv-mcp-publisher` and confirm with `ocliv mcp doctor`.

# Local MCP server to publish: http loopback URL, explicit port, exactly
# /mcp. REQUIRED. Example: http://127.0.0.1:8090/mcp
OCLIV_LOCAL_URL=

# Auth profile for the route. Publish requires upstream-oauth
# (fixture-anonymous is rejected for publish). Default: upstream-oauth.
OCLIV_AUTH=upstream-oauth

# Lease label shown in status/doctor output. Optional but recommended.
OCLIV_NAME=

# Lease TTL (e.g. 12h). Empty = relay-bounded 12h default applied by the
# CLI, so a failed remote close cannot linger indefinitely. Set longer
# explicitly for long-lived hosting.
OCLIV_TTL=

# Strict OAuth discovery: any non-empty value passes --strict-discovery
# explicitly. Strict is already the publisher default (unreachable or
# mismatched discovery fails closed), so this documents intent. The
# publisher host itself must reach the public route URL; if it cannot,
# either fix egress or leave this unset ONLY for dev/diagnostic hosts
# (unverified bindings must never be registered with ChatGPT).
OCLIV_STRICT=1

# Optional binding handoff: after registration the publisher atomically
# writes the canonical public route URL here (0600) so the local MCP
# server can advertise exactly that resource before strict discovery
# probes it. Empty = no handoff; strict discovery then passes only if
# the server was preconfigured with the route URL. Suggested value:
# /var/lib/ocliv-mcp-publisher/resource-url
OCLIV_RESOURCE_FILE=

# Binary path. Default: /usr/local/bin/ocliv. Override for dev trees.
OCLIV_BIN=
